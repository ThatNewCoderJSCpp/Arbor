if(APPLE)
    set(ARBOR_PACKAGE_GENERATORS "TGZ;TXZ;ZIP" CACHE STRING "Package formats cpack produces")
else()
    set(ARBOR_PACKAGE_GENERATORS "TGZ;TXZ;ZIP;DEB;RPM" CACHE STRING "Package formats cpack produces")
endif()
set(CPACK_GENERATOR ${ARBOR_PACKAGE_GENERATORS})
set(CPACK_PACKAGE_CONTACT "ThatNewCoderJSCpp <https://github.com/ThatNewCoderJSCpp/Arbor>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/ThatNewCoderJSCpp/Arbor")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}")
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/ArborCPackOptions.cmake")

if(NOT APPLE)
    set(_arbor_pkg "${CMAKE_CURRENT_SOURCE_DIR}/Packaging")
    install(FILES "${_arbor_pkg}/linux/arbor.desktop" DESTINATION share/applications COMPONENT arbor)
    install(FILES "${_arbor_pkg}/icons/arbor.svg" DESTINATION share/icons/hicolor/scalable/apps COMPONENT arbor)
    install(FILES "${_arbor_pkg}/icons/arbor-512.png" DESTINATION share/icons/hicolor/512x512/apps RENAME arbor.png COMPONENT arbor)

    set(_arbor_scripts "${CMAKE_BINARY_DIR}/package-scripts")
    file(MAKE_DIRECTORY "${_arbor_scripts}")
    file(COPY "${_arbor_pkg}/linux/postinst" "${_arbor_pkg}/linux/prerm" DESTINATION "${_arbor_scripts}"
        FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

    set(CPACK_DEBIAN_PACKAGE_NAME arbor)
    set(CPACK_DEBIAN_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.deb)
    set(CPACK_DEBIAN_PACKAGE_SECTION math)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${_arbor_scripts}/postinst;${_arbor_scripts}/prerm")

    set(CPACK_RPM_PACKAGE_NAME arbor)
    set(CPACK_RPM_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}.rpm)
    set(CPACK_RPM_PACKAGE_GROUP "Applications/Engineering")
    set(CPACK_RPM_PACKAGE_LICENSE "See https://github.com/ThatNewCoderJSCpp/Arbor")
    set(CPACK_RPM_PACKAGE_URL "https://github.com/ThatNewCoderJSCpp/Arbor")
    set(CPACK_RPM_PACKAGE_AUTOREQ ON)
    set(CPACK_RPM_PACKAGE_AUTOPROV OFF)
    set(CPACK_RPM_SPEC_MORE_DEFINE "%define _build_id_links none\n%define debug_package %{nil}\n%define __os_install_post %{nil}")
    set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION /opt)
    set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE "${_arbor_scripts}/postinst")
    set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE "${_arbor_scripts}/prerm")

    if(_arbor_arch STREQUAL "arm64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE arm64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE aarch64)
    elseif(_arbor_arch STREQUAL "i686")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE i386)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE i686)
    elseif(_arbor_arch STREQUAL "x86_64")
        set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
        set(CPACK_RPM_PACKAGE_ARCHITECTURE x86_64)
    endif()
endif()
